# Telegram (obrigatório)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Codex CLI (usa a autenticação da assinatura ativa na máquina)
CODEX_BINARY=codex
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=180

# Conversa
HISTORY_MAX_EXCHANGES=10
AI_SYSTEM_PROMPT="Você é meu assistente pessoal dentro do Telegram. Responda diretamente ao que eu pedir. Seja claro, prático e objetivo. Não invente informações. Quando não souber, informe claramente. Não execute tarefas externas. Não chame outros agentes. Sua única função é conversar comigo e responder no Telegram."

# Groq: opcional enquanto a transcrição de áudio não for utilizada
GROQ_API_KEY=
GROQ_TRANSCRIPTION_URL=https://api.groq.com/openai/v1/audio/transcriptions
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIPTION_LANGUAGE=pt
MAX_AUDIO_MB=20

# Filas (desabilitadas por padrão para preservar o fluxo atual)
QUEUE_ROUTING_ENABLED=false
QUEUE_DATABASE_PATH=data/inemacabot.sqlite3
SKILLS_REGISTRY_PATH=skills/registry.json
ACCEPT_JOBS_WHEN_WORKER_OFFLINE=true
WORKER_POLL_INTERVAL_MS=3000
DELIVERY_POLL_INTERVAL_MS=3000
JOB_LOCK_TIMEOUT_MINUTES=30
JOB_DEFAULT_MAX_ATTEMPTS=3
JOB_WORK_ROOT=data/jobs
JOB_EXECUTION_TIMEOUT_SECONDS=1800
DELIVERY_MAX_ATTEMPTS=5
TEST_SKILL_DELAY_SECONDS=10

# Virtual staging (opcional)
AGNES_API_KEY=
VSV_SKILLS_ROOT=/root/projetos/vsvideo-skill/skills
VSV_MAX_IMAGE_MB=10
